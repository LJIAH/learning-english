# 生产环境变量（vite build，mode=production 时自动加载）
# 站点同源：nginx 已把 /api/ /socket.io/ /ai/ /avatar/ /course/ 反代到 3000 / 3001 / 9000
# 注意结尾不能带 /

# MinIO 对象前缀：数据库里存的是 /avatar/xxx.png、/course/xxx.png，前端用 uploadUrl + path 拼接
VITE_UPLOAD_URL=https://english.kevy.top

# Socket.IO 服务地址：io(socketUrl) 会连到 https://english.kevy.top/socket.io/
VITE_SOCKET_URL=https://english.kevy.top
