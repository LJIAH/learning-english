{
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "web": "pnpm --filter @en/web dev",
    "tracker": "pnpm --filter @en/tracker dev",
    "server": "pnpm --filter @en/server start:dev",
    "ai": "pnpm --filter @en/server start:dev ai",
    "all": "concurrently \"pnpm run web\" \"pnpm run server\" \"pnpm run ai\"",
    "minio": "cd ../minio && start.cmd",
    "ngrok": "cd ../ngrok && start.cmd",
    "natapp": "cd ../natapp && run_natapp.bat",
    "dev": "concurrently -n minio,natapp,app \"pnpm minio\" \"pnpm natapp\" \"pnpm all\"",
    "test:unit": "pnpm --filter @en/tracker test",
    "test:e2e": "pnpm --filter @en/web test:e2e",
    "test:e2e:prod": "pnpm --filter @en/web test:e2e:prod",
    "test:e2e:report": "pnpm --filter @en/web test:e2e:report",
    "lint": "eslint .",
    "type-check": "pnpm -r --if-present run type-check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "server/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  }
}
