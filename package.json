{
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "web": "pnpm --filter @en/web dev",
    "tracker": "pnpm --filter @en/tracker dev",
    "server": "pnpm --filter @en/server start:dev",
    "ai": "pnpm --filter @en/server start:dev ai",
    "all": "concurrently \"pnpm run web\" \"pnpm run server\" \"pnpm run ai\"",
    "minio": "cd ../minio && start.cmd",
    "ngrok": "cd ../ngrok && start.cmd",
    "natapp": "cd ../natapp && run_natapp.bat",
    "dev": "concurrently -n minio,natapp,app \"pnpm minio\" \"pnpm natapp\" \"pnpm all\"",
    "test:unit": "pnpm --filter @en/tracker test",
    "test:e2e": "pnpm --filter @en/web test:e2e",
    "test:e2e:prod": "pnpm --filter @en/web test:e2e:prod",
    "test:e2e:report": "pnpm --filter @en/web test:e2e:report"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
