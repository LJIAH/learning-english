# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables (含密钥，禁止提交)
.env
.env.*

# 例外：前端构建期常量。VITE_* 会被 vite 内联进产物，本身是公开信息、不是密钥。
# 不提交会导致「git clone 后构建」拿不到站点地址，上传/头像/课程图/Socket 全部失效。
!apps/web/.env.production
!apps/web/.env.development

# Prisma 生成产物（按需 prisma generate 重新生成）
**/generated/prisma/

# Logs
*.log

# OS
.DS_Store

# IDE
.idea/

# 本地工具数据
.codebuddy/

# 3D 模型：源文件不入库（体积大），仅入库优化产物（部署产物需要，否则线上没模型）
#   models-src/<name>/                 原始模型（从本地模型源目录拷入，不入库）
#   public/models/<name>/scene.opt.glb 优化产物，由 pnpm --filter @en/web-react models:optimize 生成
apps/web-react/models-src/
apps/web-react/public/models/**
!apps/web-react/public/models/**/
!apps/web-react/public/models/**/*.opt.glb
!apps/web-react/public/models/**/license.txt
.workbuddy/

# Playwright 运行产物（报告/trace/截图）与 playwright-cli 快照
test-results/
playwright-report/
blob-report/
.playwright-cli/

# 本地文档（不入库）
docs/
TODO/

# 部署脚本的运行时状态（.deploy-state/previous-sha，在服务器上生成），不入库；
# 它若被看成未跟踪改动，deploy.sh 的「工作区必须干净」检查会把自己拦下
.deploy-state/
